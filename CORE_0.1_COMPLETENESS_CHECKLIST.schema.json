{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CORE_0.1_COMPLETENESS_CHECKLIST.schema.json",
  "title": "Set Calculus Core 0.1 Completeness Checklist Schema",
  "description": "Validates CORE_0.1_COMPLETENESS_CHECKLIST.yaml while allowing open-ended checklist IDs and dependency references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checklist_id",
    "title",
    "branch",
    "human_readable_source",
    "release_rule",
    "status_values",
    "item_schema",
    "owners",
    "gates",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "set-calculus-core-checklist/v1"
    },
    "checklist_id": {
      "const": "set-calculus-core-0.1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "human_readable_source": {
      "type": "string",
      "const": "CORE_0.1_COMPLETENESS_CHECKLIST.md"
    },
    "release_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "final_item_id"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "final_item_id": {
          "$ref": "#/$defs/itemId"
        }
      }
    },
    "status_values": {
      "type": "array",
      "const": [
        "pending",
        "pass",
        "fail",
        "blocked",
        "not_applicable"
      ]
    },
    "item_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "fields"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fields": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ownerRecord"
      },
      "minProperties": 1
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/gateRecord"
        },
        "B": {
          "$ref": "#/$defs/gateRecord"
        },
        "C": {
          "$ref": "#/$defs/gateRecord"
        },
        "D": {
          "$ref": "#/$defs/gateRecord"
        },
        "E": {
          "$ref": "#/$defs/gateRecord"
        },
        "F": {
          "$ref": "#/$defs/gateRecord"
        },
        "G": {
          "$ref": "#/$defs/gateRecord"
        },
        "H": {
          "$ref": "#/$defs/gateRecord"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 36,
      "items": {
        "$ref": "#/$defs/checklistItem"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "pass",
        "fail",
        "blocked",
        "not_applicable"
      ]
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable checklist item identifier. Open set: future or external item IDs are allowed."
    },
    "gateId": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H"
      ]
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "ownerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "responsibility"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail"
      ],
      "properties": {
        "pass": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "fail": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gate",
        "title",
        "required",
        "owner",
        "artifact_paths",
        "evidence",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "gate": {
          "$ref": "#/$defs/gateId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/itemId"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^A"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "A"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^B"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "B"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^C"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "C"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^D"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "D"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^E"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "E"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^F"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "F"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^G"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "G"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^H"
              }
            }
          },
          "then": {
            "properties": {
              "gate": {
                "const": "H"
              }
            }
          }
        }
      ]
    }
  }
}
