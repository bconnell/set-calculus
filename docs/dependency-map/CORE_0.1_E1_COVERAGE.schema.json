{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CORE_0.1_E1_COVERAGE.schema.json",
  "title": "Set Calculus Core 0.1 E1 Initial-Family Coverage Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source_list_path",
    "source_heading",
    "scope",
    "authority_note",
    "targets",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "PROVISIONAL_RESEARCH"
    },
    "source_list_path": {
      "type": "string",
      "minLength": 1
    },
    "source_heading": {
      "const": "Initial concept families"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "authority_note": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "node_ids",
          "rationale"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REPRESENTED",
              "OPEN_GAP"
            ]
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
