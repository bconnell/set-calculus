{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CORE_0.1_DEPENDENCY_INVENTORY.schema.json",
  "title": "Set Calculus Core 0.1 Dependency Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source_document",
    "scope",
    "authority_note",
    "allowed_classes",
    "topology_policy",
    "declared_roots",
    "open_questions",
    "nodes",
    "edges",
    "non_dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "PROVISIONAL_RESEARCH"
    },
    "source_document": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "authority_note": {
      "type": "string",
      "minLength": 1
    },
    "allowed_classes": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HARD",
          "STRONG",
          "SUPPORTING",
          "HISTORICAL/CURRICULAR"
        ]
      }
    },
    "topology_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_classes",
        "non_constraint_classes",
        "description"
      ],
      "properties": {
        "constraint_classes": {
          "type": "array",
          "items": {
            "enum": [
              "HARD",
              "STRONG"
            ]
          },
          "uniqueItems": true
        },
        "non_constraint_classes": {
          "type": "array",
          "items": {
            "enum": [
              "SUPPORTING",
              "HISTORICAL/CURRICULAR"
            ]
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "declared_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "kind",
          "rationale"
        ],
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "FOUNDATIONAL_ROOT",
              "PARALLEL_DOMAIN_ROOT",
              "UNRESOLVED_SOURCE_GAP"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "related_nodes",
          "question",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q[0-9]{3}$"
          },
          "related_nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "family",
          "include_in_teaching_layers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "include_in_teaching_layers": {
            "type": "boolean"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "class",
          "order_constraint",
          "basis",
          "source_anchor",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]{3}$"
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "HARD",
              "STRONG",
              "SUPPORTING",
              "HISTORICAL/CURRICULAR"
            ]
          },
          "order_constraint": {
            "type": "boolean"
          },
          "basis": {
            "enum": [
              "EXPLICIT_GRAPH",
              "EXPLICIT_NARRATIVE",
              "WORKING_INFERENCE"
            ]
          },
          "source_anchor": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "result",
          "source_anchor",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n[0-9]{3}$"
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "NONE"
          },
          "source_anchor": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
